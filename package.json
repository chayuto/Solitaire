{
  "name": "solitaire-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter app dev",
    "build": "pnpm --filter app build",
    "build:libs": "pnpm --filter @chayuto/solitaire-core build && pnpm --filter @chayuto/solitaire-mcts build",
    "build:all": "pnpm -r build",
    "lint": "pnpm --filter app lint",
    "test": "pnpm --filter app test",
    "test:run": "pnpm --filter app test:run",
    "test:e2e": "pnpm --filter app test:e2e",
    "test:libs": "pnpm --filter @chayuto/solitaire-core test && pnpm --filter @chayuto/solitaire-mcts test",
    "typecheck": "pnpm -r typecheck",
    "preview": "pnpm --filter app preview"
  },
  "devDependencies": {}
}
